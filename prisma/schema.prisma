generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  nom             String
  prenom          String
  password        String
  telephone       String?
  dateNaissance   DateTime?
  photo           String?
  coverPhoto      String?
  bio             String?
  role            String    @default("LECTEUR")
  isActive        Boolean   @default(true)
  lastSeenAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  posts           Post[]
  comments        Comment[]
  likes           Like[]
  liveLikes       LiveLike[]
  liveComments    LiveComment[]
  events          Event[]   @relation("EventAuthor")
  conversations   ConversationParticipant[]
  messages        Message[]
  notifications   Notification[]

  @@map("users")
}

model Post {
  id          Int       @id @default(autoincrement())
  content     String
  image       String?
  mediaUrl    String?
  mediaType   String?
  mediaName   String?
  sharesCount Int       @default(0)
  authorId    Int
  author      User      @relation(fields: [authorId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  comments    Comment[]
  likes       Like[]

  @@map("posts")
}

model Like {
  id        Int      @id @default(autoincrement())
  userId    Int
  postId    Int
  user      User     @relation(fields: [userId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@map("likes")
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  isEdited  Boolean  @default(false)
  postId    Int
  userId    Int
  parentId  Int?
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("comments")
}

model DailyReading {
  id               Int      @id @default(autoincrement())
  date             DateTime @unique
  title            String
  firstReading     String?
  psalm            String?
  secondReading    String?
  gospel           String
  liturgicalColor  String?
  commentary       String?
  image            String?
  source           String?  @default("manuel")
  liturgicalYear   String?  // A | B | C
  liturgicalSeason String?  // Temps Ordinaire, Avent, Carême...
  isSunday         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("daily_readings")
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  eventDate   DateTime
  location    String?
  image       String?
  isPublished Boolean  @default(true)
  authorId    Int
  author      User     @relation("EventAuthor", fields: [authorId], references: [id])
  createdAt   DateTime @default(now())

  @@map("events")
}

model Live {
  id          Int      @id @default(autoincrement())
  title       String
  eventType   String?  // fete | excursion | amitie | messe | autre
  description String?
  roomName    String?
  youtubeUrl  String?  // legacy
  replayUrl   String?  // rediffusion enregistrée
  scheduledAt DateTime
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())

  likes       LiveLike[]
  comments    LiveComment[]

  @@map("lives")
}

model LiveLike {
  id        Int      @id @default(autoincrement())
  userId    Int
  liveId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  live      Live     @relation(fields: [liveId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, liveId])
  @@map("live_likes")
}

model LiveComment {
  id        Int      @id @default(autoincrement())
  content   String
  userId    Int
  liveId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  live      Live     @relation(fields: [liveId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("live_comments")
}

model LiturgicalEvent {
  id        Int      @id @default(autoincrement())
  title     String
  date      DateTime
  color     String?
  note      String?
  createdAt DateTime @default(now())

  @@map("liturgical_events")
}

model Conversation {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  participants ConversationParticipant[]
  messages      Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             Int          @id @default(autoincrement())
  userId         Int
  conversationId Int
  lastReadAt     DateTime?    // ← Ce champ permet de savoir si l'utilisateur a lu les messages récents
  user           User         @relation(fields: [userId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@unique([userId, conversationId])
  @@map("conversation_participants")
}

model Message {
  id             Int          @id @default(autoincrement())
  content        String
  mediaUrl       String?
  mediaType      String?
  mediaName      String?
  isEdited       Boolean      @default(false)
  replyToId      Int?
  replyTo        Message?     @relation("MessageReplies", fields: [replyToId], references: [id])
  replies        Message[]    @relation("MessageReplies")
  senderId       Int
  conversationId Int
  sender         User         @relation(fields: [senderId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("messages")
}

model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  message   String
  url       String?
  kind      String?
  dedupeKey String?
  isRead    Boolean  @default(false)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, dedupeKey])
  @@map("notifications")
}